import time
import requests
import platform

# ---------------------------------------------------------
# 1. BEEP SOUND ALARM FUNCTION
# ---------------------------------------------------------
def play_sound_alarm():
    """Triggers an instant beep sound from the computer speaker."""
    system_name = platform.system()
    
    if system_name == "Windows":
        import winsound
        # winsound.Beep(Frequency_Hz, Duration_Milliseconds)
        winsound.Beep(1200, 600)  # 1200 Hz for 600 milliseconds
    else:
        # For macOS or Linux terminal bell sound
        print("\a")

# ---------------------------------------------------------
# 2. SPACE NEWS MONITORING FUNCTION
# ---------------------------------------------------------
API_URL = "https://api.spaceflightnewsapi.net/v4/articles/?limit=5"
seen_articles = set()

def check_space_news():
    print("\n[Info] Checking for new space news...")
    try:
        response = requests.get(API_URL)
        if response.status_code == 200:
            data = response.json()
            articles = data.get("results", [])

            for article in articles:
                article_id = article["id"]
                title = article["title"]
                url = article["url"]
                news_site = article["news_site"]

                # If it's a brand new article, trigger the alarm
                if article_id not in seen_articles:
                    print(f"\n🚨 [NEW SPACE NEWS DETECTED!] [{news_site}]")
                    print(f"Title: {title}")
                    print(f"Link: {url}")
                    
                    # --- SOUND ALERT ---
                    print("🔊 [ALARM] Beeping sound playing...")
                    play_sound_alarm()
                    
                    # Mark the article as seen
                    seen_articles.add(article_id)
                    time.sleep(0.5)
        else:
            print(f"[Error] Could not reach the API. Status code: {response.status_code}")

    except Exception as e:
        print(f"[Error] An error occurred: {e}")

# ---------------------------------------------------------
# 3. MAIN RUN LOOP (Every day / scheduled interval simulation)
# ---------------------------------------------------------
if __name__ == "__main__":
    print("🚀 Space News Alarm System Started.")
    print("🔊 Testing initial sound alert...")
    play_sound_alarm()
    
    # Run an initial check right away
    check_space_news()
    
    # In a student project, use time.sleep(86400) for 24-hour intervals (every day),
    # or use Python's 'schedule' library for exact time matching (e.g., every day at 09:00).
    while True:
        # 86400 seconds = 24 hours (Daily loop)
        time.sleep(86400) 
        check_space_news()